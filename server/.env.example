# --- Chat (Ollama Cloud) -----------------------------------------------------
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Any model from https://ollama.com/search?c=cloud
# Use the base tag, not the "-cloud" suffix, when calling ollama.com directly.
OLLAMA_MODEL=gpt-oss:120b

# Override only if you are pointing at a self-hosted Ollama instead of the cloud.
# OLLAMA_HOST=https://ollama.com

# --- Embeddings --------------------------------------------------------------
# Ollama Cloud hosts no embedding models, so this is a separate provider.
# "local" runs an ONNX model in-process and needs no key -- with it, the Ollama
# Cloud key above is the only credential this project requires.
# "local" (default) | "openai" | "ollama"
EMBEDDING_PROVIDER=local

# Required only when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Defaults per provider: Xenova/all-MiniLM-L6-v2 (local),
# text-embedding-3-small (openai), nomic-embed-text (ollama)
# EMBEDDING_MODEL=

# Only used when EMBEDDING_PROVIDER=ollama -- a self-hosted Ollama, not the cloud.
# OLLAMA_EMBED_URL=http://localhost:11434

# --- Chunking ----------------------------------------------------------------
# Pages are split before embedding. ~1000 chars is roughly 250 tokens, well
# inside the 512-token limit of the default local model. Overlap stops an answer
# that straddles a chunk boundary from being split in half.
# Changing either value requires re-uploading your PDFs to re-index.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# --- Stores ------------------------------------------------------------------
# QDRANT_URL=http://localhost:6333
# Defaults to pdf-rag-openai / pdf-rag-ollama depending on the provider, because
# the two produce different vector widths and cannot share a collection.
# QDRANT_COLLECTION=

# The valkey service from docker-compose. Named VALKEY_* rather than REDIS_*
# so an unrelated machine-wide REDIS_HOST cannot hijack the queue connection.
# VALKEY_HOST=localhost
# VALKEY_PORT=6380
